<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#2D5016</item>
        <item name="colorPrimaryDark">#1F3A0F</item>
        <item name="colorAccent">#6FA84C</item>
        
        <!-- Status Bar (top) - light background with dark icons -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F9FAFB</item>
        
        <!-- Navigation Bar (bottom) - gray background for contrast -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#D1D5DB</item>
    </style>

    <!-- Splash screen theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#F9FAFB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F9FAFB</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">#D1D5DB</item>
    </style>
</resources>
