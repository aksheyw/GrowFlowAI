# GrowFlowAI — Frontend Environment Variables
# Copy this file to `.env` and populate with your Supabase project values.

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase project's anon (public) key — safe to expose in client builds
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────
# Edge Function env vars (set in Supabase Dashboard → Edge Functions → Secrets):
#   SUPABASE_URL                 (auto-injected by Supabase)
#   SUPABASE_SERVICE_ROLE_KEY    (auto-injected by Supabase)
#   OPENAI_API_KEY               (optional — falls back to a regex parser if absent)
#
# n8n credentials (set in your n8n instance, not in .env):
#   - Telegram Bot Token (from @BotFather)
#   - Supabase service_role key
#   - OpenAI / OpenRouter API key (for voice transcription, vision OCR)
#   - Gmail/IMAP credentials (for email ingestion)
# ─────────────────────────────────────────────────────────────────────
